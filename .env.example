# Vonage API credentials, from https://dashboard.nexmo.com/settings
VONAGE_API_KEY=your_api_key
VONAGE_API_SECRET=your_api_secret

# The sender name shown in the verification SMS. Max 16 characters.
VONAGE_BRAND_NAME=Setlist

# Django
DJANGO_SECRET_KEY=change-me-to-something-random
DJANGO_DEBUG=True

# How long a successful verification stays valid, in seconds.
# After this the user is asked to verify again before transferring another ticket.
STEP_UP_TTL_SECONDS=300
